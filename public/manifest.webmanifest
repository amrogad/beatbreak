{
  "name": "PULSEGRID — Rhythm Engine",
  "short_name": "PULSEGRID",
  "description": "Load your own song, get auto-generated arrow charts, and play a four-lane rhythm game. Runs fully offline.",
  "id": "pulsegrid-rhythm-engine",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "display_override": ["fullscreen", "standalone"],
  "orientation": "any",
  "background_color": "#05060e",
  "theme_color": "#05060e",
  "categories": ["games", "music", "entertainment"],
  "icons": [
    { "src": "./icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "./icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "./icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Import a song", "url": "./index.html?action=import" }
  ]
}
